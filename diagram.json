{
  "version": 1,
  "author": "Agustin",
  "editor": "wokwi",
  "parts": [
    {
      "type": "wokwi-esp32-devkit-v1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": -10,
      "left": 300,
      "attrs": {
        "i2cAddress": "0x3c"
      }
    }
  ],
  "connections": [
    ["esp:TX0", "$serialMonitor:RX", "", []],
    ["esp:RX0", "$serialMonitor:TX", "", []],

    ["esp:D21", "oled:SDA", "green", []],
    ["esp:D22", "oled:SCL", "blue", []],

    ["esp:3V3", "oled:VCC", "red", []],
    ["esp:GND.1", "oled:GND", "black", []]
  ],
  "serialMonitor": {
    "display": "always",
    "newline": "lf"
  },
  "dependencies": {}
}